{
  "name": "connectedpapers-js",
  "version": "0.1.8",
  "description": "The official client for the connected papers API",
  "main": "dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": "https://github.com/ConnectedPapers/connectedpapers-js",
  "author": "KanHar <knaan.harpaz@gmail.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint src/ --fix",
    "lint:check": "eslint src/",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-xo": "^7.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsdown": "^0.23.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  }
